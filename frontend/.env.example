# Frontend Environment Variables
# Copy this file to .env.local for local overrides (gitignored).

# Backend API origin used by lib/api.ts (API_BASE_URL).
# Production (Vercel): falls back to this value if unset — no config required,
# or set it explicitly in Vercel Project Settings → Environment Variables.
NEXT_PUBLIC_API_URL=https://qabas-nqg8.vercel.app

# Local development: point at the local backend (used in .env.local)
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Canonical frontend origin used for metadataBase / absolute links (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
